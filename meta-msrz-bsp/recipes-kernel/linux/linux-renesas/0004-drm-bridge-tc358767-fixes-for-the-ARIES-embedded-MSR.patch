From 32ebe223c7b87bfa03d7ebbed57fb20a878ff158 Mon Sep 17 00:00:00 2001
From: Wolfgang Grandegger <wg@aries-embedded.de>
Date: Fri, 17 Apr 2026 12:22:17 +0200
Subject: [PATCH 4/5] drm/bridge: tc358767: fixes for the ARIES embedded
 MSRZV2berry board

Signed-off-by: Wolfgang Grandegger <wg@aries-embedded.de>
---
 drivers/gpu/drm/bridge/tc358767.c | 76 +++++++++++++++++++++++++------
 1 file changed, 61 insertions(+), 15 deletions(-)

diff --git a/drivers/gpu/drm/bridge/tc358767.c b/drivers/gpu/drm/bridge/tc358767.c
index a6b3af902642..0bcbb08e4eb1 100644
--- a/drivers/gpu/drm/bridge/tc358767.c
+++ b/drivers/gpu/drm/bridge/tc358767.c
@@ -39,6 +39,8 @@
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
 
+#define TC_AUX_TIMEOUT_WORKAROUND
+
 /* Registers */
 
 /* PPI layer registers */
@@ -500,8 +502,8 @@ static int tc_pllupdate(struct tc_data *tc, unsigned int pllctrl)
 	if (ret)
 		return ret;
 
-	/* Wait for PLL to lock: up to 2.09 ms, depending on refclk */
-	usleep_range(3000, 6000);
+	/* Wait for PLL to lock: up to 7.5 ms, depending on refclk */
+	usleep_range(15000, 20000);
 
 	return 0;
 }
@@ -734,12 +736,23 @@ static int tc_get_display_props(struct tc_data *tc)
 	/* Read DP Rx Link Capability */
 	ret = drm_dp_dpcd_read(&tc->aux, DP_DPCD_REV, tc->link.dpcd,
 			       DP_RECEIVER_CAP_SIZE);
-	if (ret < 0)
+	if (ret < 0) {
+#ifndef TC_AUX_TIMEOUT_WORKAROUND
 		goto err_dpcd_read;
-
-	revision = tc->link.dpcd[DP_DPCD_REV];
-	rate = drm_dp_max_link_rate(tc->link.dpcd);
-	num_lanes = drm_dp_max_lane_count(tc->link.dpcd);
+#else
+		if (ret != -ETIMEDOUT)
+			goto err_dpcd_read;
+		dev_warn(tc->dev, "DPCD read timed out, "
+			 "continuing with default values\n");
+		revision = 0x11;
+		rate = 270000;
+		num_lanes = 2;
+#endif
+	} else {
+		revision = tc->link.dpcd[DP_DPCD_REV];
+		rate = drm_dp_max_link_rate(tc->link.dpcd);
+		num_lanes = drm_dp_max_lane_count(tc->link.dpcd);
+	}
 
 	if (rate != 162000 && rate != 270000) {
 		dev_dbg(tc->dev, "Falling to 2.7 Gbps rate\n");
@@ -756,20 +769,42 @@ static int tc_get_display_props(struct tc_data *tc)
 	tc->link.num_lanes = num_lanes;
 
 	ret = drm_dp_dpcd_readb(&tc->aux, DP_MAX_DOWNSPREAD, &reg);
-	if (ret < 0)
+	if (ret < 0) {
+#ifndef TC_AUX_TIMEOUT_WORKAROUND
 		goto err_dpcd_read;
-	tc->link.spread = reg & DP_MAX_DOWNSPREAD_0_5;
+#else
+		if (ret != -ETIMEDOUT)
+			goto err_dpcd_read;
+		tc->link.spread = DP_MAX_DOWNSPREAD_0_5;
+#endif
+	} else {
+		tc->link.spread = reg & DP_MAX_DOWNSPREAD_0_5;
+	}
 
 	ret = drm_dp_dpcd_readb(&tc->aux, DP_MAIN_LINK_CHANNEL_CODING, &reg);
-	if (ret < 0)
+	if (ret < 0) {
+#ifndef TC_AUX_TIMEOUT_WORKAROUND
 		goto err_dpcd_read;
+#else
+		if (ret != -ETIMEDOUT)
+			goto err_dpcd_read;
+#endif
+	}
 
 	tc->link.scrambler_dis = false;
 	/* read assr */
 	ret = drm_dp_dpcd_readb(&tc->aux, DP_EDP_CONFIGURATION_SET, &reg);
-	if (ret < 0)
+	if (ret < 0) {
+#ifndef TC_AUX_TIMEOUT_WORKAROUND
 		goto err_dpcd_read;
-	tc->link.assr = reg & DP_ALTERNATE_SCRAMBLER_RESET_ENABLE;
+#else
+		if (ret != -ETIMEDOUT)
+			goto err_dpcd_read;
+		tc->link.assr = 0;
+#endif
+	} else {
+		tc->link.assr = reg & DP_ALTERNATE_SCRAMBLER_RESET_ENABLE;
+	}
 
 	dev_dbg(tc->dev, "DPCD rev: %d.%d, rate: %s, lanes: %d, framing: %s\n",
 		revision >> 4, revision & 0x0f,
@@ -1475,7 +1510,9 @@ tc_edp_bridge_atomic_enable(struct drm_bridge *bridge,
 	ret = tc_get_display_props(tc);
 	if (ret < 0) {
 		dev_err(tc->dev, "failed to read display props: %d\n", ret);
+#if 0
 		return;
+#endif
 	}
 
 	ret = tc_main_link_enable(tc);
@@ -1572,7 +1609,7 @@ static void tc_bridge_mode_set(struct drm_bridge *bridge,
 {
 	struct tc_data *tc = bridge_to_tc(bridge);
 
-	drm_mode_copy(&tc->mode, mode);
+	drm_mode_copy(&tc->mode, adj);
 }
 
 static struct edid *tc_get_edid(struct drm_bridge *bridge,
@@ -1848,7 +1885,7 @@ static irqreturn_t tc_irq_handler(int irq, void *arg)
 		dev_err(tc->dev, "syserr %x\n", stat);
 	}
 
-	if (tc->hpd_pin >= 0 && tc->bridge.dev && tc->aux.drm_dev) {
+	if (tc->hpd_pin >= 0 && tc->bridge.dev) {
 		/*
 		 * H is triggered when the GPIO goes high.
 		 *
@@ -1906,7 +1943,8 @@ static int tc_mipi_dsi_host_attach(struct tc_data *tc)
 
 	dsi->lanes = dsi_lanes;
 	dsi->format = MIPI_DSI_FMT_RGB888;
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE;
+        dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+                          MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
 
 	ret = devm_mipi_dsi_attach(dev, dsi);
 	if (ret < 0) {
@@ -1954,8 +1992,10 @@ static int tc_probe_edp_bridge_endpoint(struct tc_data *tc)
 
 	/* port@2 is the output port */
 	ret = drm_of_find_panel_or_bridge(dev->of_node, 2, 0, &panel, NULL);
+#if 0
 	if (ret && ret != -ENODEV)
 		return ret;
+#endif
 
 	if (panel) {
 		struct drm_bridge *panel_bridge;
@@ -2170,9 +2210,15 @@ static int tc_probe(struct i2c_client *client, const struct i2c_device_id *id)
 	}
 
 	if (tc->bridge.type != DRM_MODE_CONNECTOR_DPI) { /* (e)DP output */
+		struct drm_dp_aux_msg aux_msg;
+
 		ret = tc_aux_link_setup(tc);
 		if (ret)
 			return ret;
+
+		memset(&aux_msg, 0, sizeof(aux_msg));
+		aux_msg.request = DP_AUX_I2C_WRITE;
+		aux_msg.size = 0;
 	}
 
 	tc->bridge.of_node = dev->of_node;
-- 
2.34.1

